// Config de niri gestionada por NixOS (loon-flakes).
// Los binds por defecto se eliminaron a propósito: solo existe Super+Enter → ghostty.
// Edita este archivo en ~/.nixos/modules/wayland/niri/config.kdl y corre `rebuild`.
// Referencia: https://niri-wm.github.io/niri/Configuration:-Introduction

input {
    keyboard {
        // Layout predeterminado. Nix sustituye esta línea con el layout del host.
        xkb {
            layout "es" // HOST_KEYBOARD_LAYOUT
        }
        numlock
    }

    touchpad {
        tap
        // Click con 1 dedo = izquierdo, con 2 dedos = derecho.
        tap-button-map "left-right-middle"
        click-method "clickfinger"
    }
}

// Nix reemplaza este marcador con ajustes de salida exclusivos del host.
// HOST_OUTPUT_CONFIG

// Tema de cursor: Win11OSX (Xcursor nativo de Linux, en pkgs/win11osx-cursor).
cursor {
    xcursor-theme "Win11OSX"
    xcursor-size 32
}

layout {
    // Ventanas nuevas al 100% del ancho (efecto "maximizado").
    default-column-width { proportion 1.0; }

    // Fondo transparente: deja ver el backdrop (donde está el wallpaper).
    // Requiere que el wallpaper use place-within-backdrop (ver más abajo).
    background-color "transparent"

    gaps 8

    // Sustituye el focus-ring azul por defecto por un borde fino.
    focus-ring {
        off
    }

    border {
        on
        width 1
        active-color "#5e81ac"
        inactive-color "#3b4252"
    }
}

// Sin atajos por defecto: solo los binds explícitos de aquí.

// Lanza el fondo animado al iniciar la sesión (usa el video seteado o el único).
spawn-at-startup "mpvpaper-wallpaper"
// Lanza el fondo estático del backdrop (imagen, fondo de todo).
spawn-at-startup "niri-backdrop"
// Los procesos persistentes (Waybar, SwayNC, automontaje, portapapeles,
// loon-launch e Hypridle) son servicios systemd de usuario supervisados en
// session-services.nix. Aquí quedan solo inicializadores de wallpaper y el
// monitor de batería, que pueden terminar normalmente si no aplican al host.
// Daemon de alertas de batería baja crítica (<=10% cada 1 minuto).
spawn-at-startup "battery-notify"

binds {
    // Bloquear pantalla manualmente con Super+L
    Super+L { spawn "hyprlock"; }
    // Fondo animado con mpvpaper: video en loop detrás de las ventanas.
    // Pon tus videos en ~/Videos/Wallpapers. Con Super+B se reproduce el
    // video seteado (o el único). Para elegir: mpvpaper-wallpaper set NOMBRE.
    Super+Return { spawn "ghostty"; }
    // Launcher: toggle del daemon persistente (arranca con spawn-at-startup).
    Super+Space { spawn "loon-launch"; }
    // Explorador de archivos (Nautilus) con Super+E, como en Windows.
    Super+E { spawn "nautilus"; }
    // Android (Waydroid): arranca la sesión si no está y muestra la ventana.
    Super+D { spawn "waydroid" "show-full-ui"; }
    Super+Q { close-window; }
    Super+F { maximize-column; }

    // Selector de fondos integrado en loon-launch: videos (animado) e
    // imágenes (backdrop) con miniaturas, en el launcher custom.
    Super+B { spawn "loon-launch" "wallpapers"; }

    // Elegir solo el fondo estático del backdrop (fuzzel + awww, transición).
    Super+Shift+B { spawn "niri-backdrop" "pick"; }

    // Siguiente fondo estático (cíclico) con Super+Shift+N.
    Super+Shift+N { spawn "niri-backdrop" "next"; }

    // Captura de pantalla con Super+Shift+S: congela la pantalla, selecciona
    // el área con el mouse y Ctrl+C copia al portapapeles (sin guardar a disco).
    Super+Shift+S { screenshot; }

    // Pegar desde el historial de portapapeles (cliphist + fuzzel): útil cuando
    // una app (p. ej. Equibop/Discord) no acepta Ctrl+V de imágenes externas
    // (bug de Chromium); eliges la captura del historial y se copia de nuevo.
    Super+Shift+V { spawn-sh "cliphist list | fuzzel --dmenu | cliphist decode | wl-copy"; }

    // Centro de notificaciones (SwayNC): abre/cierra el panel con las
    // notificaciones acumuladas (el icono del tray en waybar también).
    Super+N { spawn "swaync-client" "-t" "-sw"; }

    // Nix inserta aquí los binds y el backend de brillo específicos del host.
    // HOST_BACKLIGHT_BINDS

    // Volumen con las teclas multimedia Fn+F2 / Fn+F3 (pipewire).
    XF86AudioLowerVolume { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"; }
    XF86AudioRaiseVolume { spawn-sh "wpctl set-volume --limit 1.0 @DEFAULT_AUDIO_SINK@ 5%+"; }

    // Moverse entre ventanas/workspaces con wrap infinito:
    // al llegar al extremo, salta al otro lado.
    Super+Left { spawn-sh "niri-cycle left"; }
    Super+Right { spawn-sh "niri-cycle right"; }

    // Cambiar de workspace con Super+1..9.
    Super+1 { focus-workspace 1; }
    Super+2 { focus-workspace 2; }
    Super+3 { focus-workspace 3; }
    Super+4 { focus-workspace 4; }
    Super+5 { focus-workspace 5; }
    Super+6 { focus-workspace 6; }
    Super+7 { focus-workspace 7; }
    Super+8 { focus-workspace 8; }
    Super+9 { focus-workspace 9; }
}

// Toda ventana abre maximizada (ancho completo + estado maximizado),
// con esquinas redondeadas. El borde se dibuja como trazo fino SIN fondo
// sólido, para no tapar la transparencia de las ventanas.
window-rule {
    match app-id=".*"
    exclude app-id=r#"^(waydroid(\..*)?|com\.waydroid\..*|loon-launch|dev\.loonbac\.loonlaunch)$"#
    open-maximized true

    geometry-corner-radius 12
    clip-to-geometry true

    draw-border-with-background false
}

// loon-launch: flotante y centrado. El launcher normal conserva 680x350;
// el selector de wallpapers puede ensancharse para mostrar su carrusel.
window-rule {
    match app-id=r#"^(loon-launch|dev\.loonbac\.loonlaunch)$"#

    open-floating true
    open-maximized false
    default-column-width { fixed 680; }
    default-window-height { fixed 350; }
    min-width 680
    min-height 350
    max-width 1400
    max-height 590

    geometry-corner-radius 18
    clip-to-geometry true
    draw-border-with-background false
}

// El selector de wallpapers usa una superficie transparente: no dibujar el
// borde ni el recorte exterior de la ventana alrededor del carrusel.
window-rule {
    match app-id=r#"^(loon-launch|dev\.loonbac\.loonlaunch)$"# title="^loon-wallpaper-picker$"

    geometry-corner-radius 0
    clip-to-geometry false
    border { off; }
}

// loon-bar: barra de tareas Wayland Layer Shell (panel anclado en todos los
// workspaces). No necesita layer-rule: el KeyboardMode::None del código ya
// evita que robe el foco; block-out-from solo acepta screencast/screen-capture.

// ghostty: transparencia real a nivel de compositor (opacity afecta toda
// la ventana, no solo el fondo — el background-opacity de ghostty no produce
// transparencia real en niri).
// xray: hace que el fondo de la ventana "vea a través" hasta el wallpaper
// (sin xray, una ventana transparente muestra el color de fondo de niri,
// no el wallpaper). Va después de la regla genérica.
window-rule {
    match app-id="^com\\.mitchellh\\.ghostty$"

    opacity 0.8
    background-effect {
        xray true
    }
}

// mpvpaper: el video va en la capa background de CADA workspace (animado,
// se mueve con los workspaces). El fondo estático de todo (backdrop) lo pone
// niri-backdrop con awww/swww (que sí ignora exclusive zones).
// OJO: no usar place-within-backdrop aquí — mpvpaper manda exclusive_zone(-1),
// no califica para el backdrop, y además congelaría el video (issue #4038).
//
// niri-backdrop: el fondo estático del backdrop (awww-daemon con namespace
// "wallpaper" -> app-id "awww-daemonwallpaper"). place-within-backdrop lo
// mueve al backdrop (fondo de todo).
layer-rule {
    match namespace="^awww-daemonwallpaper$"

    place-within-backdrop true
}

// Color de acento dinámico: lo escribe accent-wallpaper (script del flake)
// con el color más llamativo del video de wallpaper. Va AL FINAL (después
// del bloque layout) para que el override del border pise el azul default.
// niri vigila este archivo y recarga la config en vivo al cambiar.
include "~/.config/niri/accent.kdl"
